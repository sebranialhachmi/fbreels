# ---- Site -------------------------------------------------------------------
# Public origin used for canonical URLs, hreflang, sitemap and robots (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Product name used everywhere (default: ReelSave).
NEXT_PUBLIC_BRAND_NAME=ReelSave
# Optional: public contact address shown on the Contact page (display only).
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Extraction provider (server-side only) --------------------------------
# none (default) | mock (development/tests only, refused in production) | http-json
MEDIA_EXTRACTOR_PROVIDER=none
# Required for http-json: https endpoint of the approved extraction service.
MEDIA_EXTRACTOR_BASE_URL=
MEDIA_EXTRACTOR_API_KEY=
# Optional tuning
MEDIA_EXTRACTOR_TIMEOUT_MS=20000
# true = expand fb.watch/share links (SSRF-guarded) before sending them to the provider.
MEDIA_EXTRACTOR_EXPAND_LINKS=false
# Comma-separated host suffixes the download proxy may fetch from (e.g. fbcdn.net). Empty = any public https host.
MEDIA_DOWNLOAD_HOST_ALLOWLIST=
EXTRACT_MAX_CONCURRENCY=4
DOWNLOAD_MAX_MB=512

# Secret for download tokens. REQUIRED in production, at least 32 random characters.
# Generate with: openssl rand -hex 32
DOWNLOAD_TOKEN_SECRET=

# ---- Abuse prevention -------------------------------------------------------
EXTRACT_RATE_LIMIT=10
EXTRACT_RATE_WINDOW_SECONDS=60
DOWNLOAD_RATE_LIMIT=20
DOWNLOAD_RATE_WINDOW_SECONDS=60
# Shared limiter for multi-instance/serverless deployments (Upstash-compatible Redis REST API).
RATE_LIMIT_REST_URL=
RATE_LIMIT_REST_TOKEN=
# Set to false if the app is NOT behind a trusted proxy (then client IPs are not read from X-Forwarded-For).
TRUST_PROXY_HEADERS=true

# ---- Contact form delivery (Resend REST API) -------------------------------
CONTACT_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_PROVIDER_API_KEY=

# ---- Advertising / analytics (all optional, off when blank) ----------------
# Format: ca-pub-0000000000000000 (use the real id from your AdSense account)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_BELOW_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_BETWEEN_SECTIONS=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_ABOVE_FOOTER=
# builtin = ads load only after the built-in banner records advertising consent.
# google-cmp = a Google-certified CMP configured in your AdSense account handles consent.
NEXT_PUBLIC_CONSENT_MODE=builtin
# Plausible Analytics domain (e.g. example.com). Loaded only after analytics consent.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
