# ---- Site -------------------------------------------------------------------
# Public origin used for canonical URLs, sitemap and robots (no trailing slash). REQUIRED in production.
NEXT_PUBLIC_SITE_URL=https://omrataxi-sa.online
# Site name shown everywhere (default: حاسبة مكافأة نهاية الخدمة).
NEXT_PUBLIC_BRAND_NAME=
# Optional: public contact address shown on the contact page (display only; never invented).
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Contact form delivery (Resend REST API) — all three needed, otherwise the form says "unavailable" -----
CONTACT_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_PROVIDER_API_KEY=

# ---- Abuse prevention (contact form) ----------------------------------------
# Shared limiter for multi-instance/serverless deployments (Upstash-compatible Redis REST API). Optional.
RATE_LIMIT_REST_URL=
RATE_LIMIT_REST_TOKEN=
# Set to false if the app is NOT behind a trusted proxy (then client IPs are not read from X-Forwarded-For).
TRUST_PROXY_HEADERS=true

# ---- Advertising / analytics (all optional, off when blank) ----------------
# Format: ca-pub-0000000000000000 (use the real id from your AdSense account)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_BELOW_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_BETWEEN_SECTIONS=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
# builtin = ads load only after the built-in banner records advertising consent.
# google-cmp = a Google-certified CMP configured in your AdSense account handles consent.
NEXT_PUBLIC_CONSENT_MODE=builtin
# true = also load the ad script (and show the below-calculator ad slot) on pages that contain the salary calculator.
# Default (blank/false) keeps third-party scripts off the pages where visitors type their wage.
NEXT_PUBLIC_ADS_ON_CALCULATOR_PAGES=
# Plausible Analytics domain (e.g. example.com). Loaded only after analytics consent.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
